# If the device is Battlemage, we need to set UBUNTU_VERSION to 24.10

# Usage: docker build --build-arg UBUNTU_VERSION=24.04 --build-arg PYTHON_VERSION=3.12 -t sglang:xpu_kernel -f  Dockerfile.xpu --no-cache .


FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

# Define build arguments
ARG PYTHON_VERSION=3.12

# Set environment variables

ARG SG_LANG_REPO=https://github.com/sgl-project/sglang.git
ARG SG_LANG_BRANCH=main

ARG SG_LANG_KERNEL_REPO=https://github.com/sgl-project/sgl-kernel-xpu.git
ARG SG_LANG_KERNEL_BRANCH=main
# ON builds the runtime-JIT wheel (FMHA/MLA/MoE/GDN compiled on first use).
ARG USE_SYCL_JIT=OFF

# GPU driver stack and oneAPI toolchain from one versioned Intel OMIX release.
ARG INTEL_OMIX_VERSION=0.5.0
# oneAPI toolkit version shipped by INTEL_OMIX_VERSION; bump together.
ARG ONEAPI_VERSION=2026.2
RUN apt-get update && apt-get install -y \
        ca-certificates curl gpg wget git file cmake build-essential pkg-config \
        software-properties-common && \
    curl -fsSL https://repositories.intel.com/gpu/intel-graphics.key | \
        gpg --yes --dearmor --output /usr/share/keyrings/intel-graphics.gpg && \
    echo "deb [arch=amd64 signed-by=/usr/share/keyrings/intel-graphics.gpg] https://repositories.intel.com/gpu/ubuntu noble/intel-omix/${INTEL_OMIX_VERSION} unified" \
        > /etc/apt/sources.list.d/intel-gpu-noble.list && \
    # Fail here if the omix channel can't be fetched.
    apt-get update -o APT::Update::Error-Mode=any && \
    apt-get install -y \
        intel-omix-dev intel-metrics-discovery clinfo \
        intel-media-va-driver-non-free libmfx-gen1 libvpl2 libvpl-tools libva-glx2 va-driver-all vainfo && \
    test -x /opt/intel/oneapi/${ONEAPI_VERSION}/bin/icpx && \
    rm -rf /var/lib/apt/lists/*

# Static equivalent of setvars.sh for the unified oneAPI layout, so build steps,
# docker exec and runtime all see icpx and the oneAPI libs.
ENV ONEAPI_ROOT=/opt/intel/oneapi/${ONEAPI_VERSION}
ENV CMPLR_ROOT=${ONEAPI_ROOT} \
    MKLROOT=${ONEAPI_ROOT} \
    TBBROOT=${ONEAPI_ROOT} \
    CCL_ROOT=${ONEAPI_ROOT} \
    CCL_CONFIGURATION=cpu_gpu_dpcpp \
    Pti_DIR=${ONEAPI_ROOT}/lib/cmake/pti \
    PATH=${ONEAPI_ROOT}/bin:${PATH} \
    LD_LIBRARY_PATH=${ONEAPI_ROOT}/lib \
    LIBRARY_PATH=${ONEAPI_ROOT}/lib \
    C_INCLUDE_PATH=${ONEAPI_ROOT}/include \
    CPLUS_INCLUDE_PATH=${ONEAPI_ROOT}/include \
    CMAKE_PREFIX_PATH=${ONEAPI_ROOT} \
    PKG_CONFIG_PATH=${ONEAPI_ROOT}/lib/pkgconfig \
    SETVARS_COMPLETED=1
# Log vars oneapi-vars.sh sets that differ from the ENV above (informational only).
RUN icpx --version && \
    { env -i bash -c ". ${ONEAPI_ROOT}/oneapi-vars.sh >/dev/null; env" || true; } | sort > /tmp/oneapi.env && \
    env | sort | comm -13 - /tmp/oneapi.env | sed 's/^/oneapi-vars only: /' && \
    rm -f /tmp/oneapi.env

# Install uv and create the Python environment
ARG UV_VERSION=0.12.18
RUN curl -LsSf "https://astral.sh/uv/${UV_VERSION}/install.sh" | UV_NO_MODIFY_PATH=1 sh
ENV PATH="/root/.local/bin:$PATH"
ENV VIRTUAL_ENV=/opt/venv
ENV UV_PYTHON_INSTALL_DIR=/opt/uv/python
ENV UV_PYTHON_PREFERENCE=only-managed
ENV UV_LINK_MODE=copy
# Large wheel downloads (torch, triton-xpu) - allow slow, flaky fetches
ENV UV_HTTP_TIMEOUT=300
ENV UV_HTTP_RETRIES=10
RUN uv venv --python ${PYTHON_VERSION} --seed ${VIRTUAL_ENV} && \
    echo ". ${VIRTUAL_ENV}/bin/activate; . /opt/intel/oneapi/setvars.sh; cd /root/" >> /root/.bashrc
ENV PATH="${VIRTUAL_ENV}/bin:$PATH"

# Install Torch
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install torch==2.14.0 torchvision triton-xpu --index-url https://download.pytorch.org/whl/xpu

# Install SGlang from source
RUN --mount=type=cache,target=/root/.cache/uv \
    cd /root && \
    echo "cloning ${SG_LANG_BRANCH} from ${SG_LANG_REPO}" && \
    git clone --branch ${SG_LANG_BRANCH} --single-branch ${SG_LANG_REPO} && \
    cd sglang && \
    # Clone sgl-kernel and build sglang-kernel...
    echo "cloning ${SG_LANG_KERNEL_REPO} from ${SG_LANG_KERNEL_BRANCH}" && \
    git clone --branch ${SG_LANG_KERNEL_BRANCH} --single-branch ${SG_LANG_KERNEL_REPO} && \
    cd sgl-kernel-xpu && \
    # Build deps for --no-build-isolation; keep in sync with [build-system].requires in pyproject.toml
    uv pip install "scikit-build-core>=0.10" cmake ninja wheel && \
    USE_SYCL_JIT=${USE_SYCL_JIT} uv pip install -v --no-build-isolation . && \
    # Install required packages for sglang workloads
    uv pip install msgspec blake3 py-cpuinfo compressed_tensors gguf partial_json_parser einops matplotlib pandas aiohttp

# Set the default shell to bash
SHELL ["bash", "-c"]
CMD ["bash", "-c", "source /root/.bashrc && exec bash"]
USER root
