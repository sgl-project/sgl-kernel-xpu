+class XpuGDNVerifyKernel:
+    """SYCL target_verify. Reads the committed SSM state and writes snapshots."""
+
+    def target_verify(
+        self,
+        A_log,
+        dt_bias,
+        q,
+        k,
+        v,
+        a,
+        b,
+        *,
+        ssm_states,
+        cache_indices,
+        query_start_loc,
+        intermediate_states_buffer,
+        intermediate_state_indices,
+        cache_steps,
+        retrieve_parent_token,
+        **kwargs,
+    ):
+        def flat_qkv(t):
+            if t.dim() == 4:
+                return t.reshape(-1, t.shape[-2], t.shape[-1]).contiguous()
+            if t.dim() == 3:
+                return t.contiguous()
+            raise RuntimeError(f"GDN verify qkv rank {t.dim()}")
 
+        def flat_gate(t):
+            if t.dim() == 3:
+                t = t.reshape(-1, t.shape[-1])
+            return t.contiguous()
 
+        qf, kf, vf = flat_qkv(q), flat_qkv(k), flat_qkv(v)
+        af, bf = flat_gate(a), flat_gate(b)
+        nseq = int(query_start_loc.shape[0] - 1)
+        idx = cache_indices[:nseq].to(torch.int32).contiguous()
+        iidx = intermediate_state_indices[:nseq].to(torch.int32).contiguous()
+        parent = retrieve_parent_token
+        if parent is not None:
+            parent = parent.contiguous()
+        if A_log.dtype != torch.float32:
+            A_log = A_log.float()
+        if dt_bias.dtype != vf.dtype:
+            dt_bias = dt_bias.to(vf.dtype)
+        out = torch.empty(
+            (qf.shape[0], vf.shape[1], vf.shape[2]),
+            dtype=vf.dtype,
+            device=vf.device,
+        )
+        torch.ops.sgl_kernel.gated_delta_rule_verify(
+            out,
+            qf,
+            kf,
+            vf,
+            bf,
+            af,
+            A_log,
+            dt_bias,
+            ssm_states,
+            idx,
+            intermediate_states_buffer,
+            iidx,
+            int(cache_steps),
+            None,
+            parent,
+        )
+        return out.view(v.shape)
+
