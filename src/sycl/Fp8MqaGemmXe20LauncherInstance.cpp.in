// Runtime-JIT launcher instance for the FP8 MQA-logits batched GEMM.
//
// Rendered + compiled on demand by src/jit/fp8_mqa_jit.cpp (one tile config per
// .so). Mirrors the single call site in src/sycl/Fp8MqaLogitsXe20.cpp so the
// heavy SYCL-TLA FP8 GEMM instantiation is emitted here at runtime instead of
// being baked into the AOT wheel.
#define SYCL_INTEL_TARGET 20

#include <ATen/ATen.h>
#include <c10/xpu/XPUStream.h>
#include <torch/all.h>

#include <cstdint>

#include <cute/tensor.hpp>

#include "sycl/kernels/nsa/fp8_mqa_gemm_xe20.hpp"

// Stable C ABI entry for the runtime-JIT path. Only emitted when this TU is
// compiled as a standalone JIT module, so the fixed symbol name never collides.
#ifdef SGL_FP8_MQA_JIT_ENTRY
extern "C" __attribute__((visibility("default"))) void sgl_fp8_mqa_gemm_entry(
    void* queue_ptr,
    const void* A_fp8,
    const void* B_fp8,
    void* D_f32,
    int batch,
    int M,
    int N,
    int K,
    int64_t A_batch_stride,
    int64_t B_batch_stride,
    int64_t D_batch_stride) {
  nsa::fp8_mqa_gemm_batched_launch<@GEMM_TILE@>(
      static_cast<sycl::queue*>(queue_ptr),
      A_fp8,
      B_fp8,
      D_f32,
      batch,
      M,
      N,
      K,
      A_batch_stride,
      B_batch_stride,
      D_batch_stride);
}
#endif

#undef SYCL_INTEL_TARGET
