#define SYCL_INTEL_TARGET 20

#include <ATen/ATen.h>
#include <c10/xpu/XPUStream.h>
#include <torch/all.h>

#include <cute/tensor.hpp>

#include "sycl/Utils.h"
#include "cutlass/gemm/device/gemm_universal_adapter.h"
#include "cutlass/gemm/group_array_problem_shape.hpp"
#include "sycl/kernels/moe/xe20/fp8_w8a8/moe_kernel.hpp"

using namespace cute;

template <typename, typename, typename, typename, typename, typename, int, bool, bool>
class GemmXe20Fp8W8A8Name;

template <typename Tile, typename SGLayout, int ActType, bool FuseAct, bool WithBias>
void Xe20MoEGEMMFp8W8A8Launcher(
    sycl::queue q,
    const void* activations,
    const void* act_scales,
    const void* weights,
    const void* weight_scales,
    const void* bias,
    void* outputs,
    const int gemm_n,
    const int gemm_k,
    const int* num_rows_per_expert_device,
    const int num_experts,
    int* workspace,
    float gemm1_alpha,
    float gemm1_limit,
    int ld_b_param) {
  // D stays bf16 to match the rest of the MoE bf16/MXFP4 pipeline
  // (hidden_states dtype, apply_shuffle_mul_sum combine kernel). A and B
  // are decoded from fp8 e4m3 to fp16 in-kernel for the DPAS - see
  // moe_mainloop.hpp header comment for why fp16 (not bf16) is the
  // in-kernel compute type here.
  using ElementD = cutlass::bfloat16_t;

  auto make_dummy_tensor_fp8 = [&](auto val, auto stride) {
    return make_tensor(make_gmem_ptr(&val), make_layout(repeat<rank_v<decltype(stride)>>(1), stride));
  };
  auto make_dummy_tensor_bf16 = [&](auto val, auto stride) {
    return make_tensor(make_gmem_ptr(&val), make_layout(repeat<rank_v<decltype(stride)>>(1), stride));
  };
  auto make_dummy_bias = [&](auto val) {
    if constexpr (FuseAct && ActType == 2) {  // SWIGLU_GPT_OSS: interleaved, stride 2
      return make_tensor(make_gmem_ptr(&val), make_layout(Shape<int>{}, Stride<_2>{}));
    } else {
      return make_tensor(make_gmem_ptr(&val), make_layout(Shape<int>{}, Stride<_1>{}));
    }
  };

  using StrideA = Stride<int, _1>;
  using StrideB = Stride<int, _1>;
  using StrideD = Stride<int, _1>;

  // TensorA/TensorBPacked are dummy typed tensors used only to select the
  // TiledCopy/TiledMMA layout at compile time (same "launcher dummy
  // tensor" convention as the bf16/MXFP4 launchers) - the real gmem
  // pointers are rebuilt per-expert inside the kernel from raw uint8_t*.
  using TensorA = decltype(make_dummy_tensor_fp8(cutlass::float_e4m3_t{}, StrideA{}));
  using TensorBPacked = decltype(make_dummy_tensor_fp8(cutlass::float_e4m3_t{}, StrideB{}));
  using TensorD = decltype(make_dummy_tensor_bf16(ElementD{}, StrideD{}));
  using TensorBias = decltype(make_dummy_bias(float{}));

  // fp16 DPAS: Xe2 has no native fp8xfp8 MMA atom, so A and B are both
  // decoded to fp16 in registers before cute::gemm (see moe_mainloop.hpp).
  using MMA = typename TiledMMAHelper<MMA_Atom<XE_DPAS_TT<8, float, cutlass::half_t>>, Layout<Tile>, SGLayout>::TiledMMA;
  auto mma = MMA{};

  int sm_count = cutlass::KernelHardwareInfo::query_device_multiprocessor_count(0);
  auto MaxThreadsPerWorkgroup = size(mma);

  static constexpr int MaxThreadsPerSM = 512;
  TORCH_CHECK(
      MaxThreadsPerSM % MaxThreadsPerWorkgroup == 0, "MaxThreadsPerSM must be divisible by MaxThreadsPerWorkgroup");

  sycl::range<3> local(1, 1, MaxThreadsPerWorkgroup);
  sycl::range<3> global(1, sm_count * MaxThreadsPerSM / MaxThreadsPerWorkgroup, 1);

  namespace syclex = sycl::ext::oneapi::experimental;
  namespace intelex = sycl::ext::intel::experimental;

  syclex::properties kernel_props{syclex::sub_group_size<16>, intelex::grf_size<256>};

  using Kernel = MoE_FP8_W8A8::MoEGEMMFp8W8A8<
      Tile,
      SGLayout,
      TensorA,
      TensorBPacked,
      TensorD,
      TensorBias,
      MMA,
      ActType,
      FuseAct,
      WithBias,
      ElementD>;
  typename Kernel::Params params{
      static_cast<const uint8_t*>(activations),
      static_cast<const uint8_t*>(weights),
      static_cast<const float*>(weight_scales),
      static_cast<const float*>(act_scales),
      static_cast<const float*>(bias),
      static_cast<ElementD*>(outputs),
      num_rows_per_expert_device,
      gemm_n,
      gemm_k,
      num_experts,
      workspace,
      mma,
      static_cast<int32_t>(ld_b_param),
      static_cast<float>(gemm1_alpha),
      static_cast<float>(gemm1_limit),
  };

  q.submit([&](sycl::handler& h) {
    sycl::local_accessor<int32_t, 1> local_mem(sycl::range<1>(1), h);
    h.parallel_for<GemmXe20Fp8W8A8Name<
        Tile,
        SGLayout,
        TensorA,
        TensorBPacked,
        TensorD,
        ElementD,
        ActType,
        FuseAct,
        WithBias>>(
        sycl::nd_range<3>(global * local, local), kernel_props, [=](sycl::nd_item<3> item) {
          int32_t* slm_mem =
              static_cast<int32_t*>(local_mem.template get_multi_ptr<sycl::access::decorated::no>().get());
          Kernel{}(params, item, slm_mem);
        });
  });
}

template void Xe20MoEGEMMFp8W8A8Launcher<@TILE@, @SGLAYOUT@, @ACT_TYPE@, @FUSE_ACT@, @WITH_BIAS@>(
    sycl::queue,
    const void*,
    const void*,
    const void*,
    const void*,
    const void*,
    void*,
    const int,
    const int,
    const int*,
    const int,
    int*,
    float,
    float,
    int);

#undef SYCL_INTEL_TARGET
