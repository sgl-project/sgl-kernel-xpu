#undef SYCL_INTEL_TARGET
#define SYCL_INTEL_TARGET 20

#include <ATen/ATen.h>
#include <c10/xpu/XPUStream.h>
#include <torch/all.h>

#include <cute/tensor.hpp>

#include "sycl/Utils.h"
#include "cutlass/gemm/device/gemm_universal_adapter.h"
#include "cutlass/gemm/group_array_problem_shape.hpp"
#include "sycl/kernels/moe/xe20/w8a16/moe_kernel.hpp"

using namespace cute;

template <typename, typename, typename, typename, typename, typename, bool>
class GemmXe20W8A16Name;

template <typename Tile, typename SGLayout, bool IsInt8>
void Xe20MoEGEMMW8A16Launcher(
    sycl::queue q,
    const void* activations,
    const void* weights,
    const void* weight_scales,
    const void* weight_zeros,
    const void* bias,
    void* outputs,
    const int gemm_n,
    const int gemm_k,
    const int* num_rows_per_expert_device,
    const int num_experts,
    int* workspace,
    int ld_b_param,
    int64_t expert_stride_b_param,
    int64_t expert_stride_s_param,
    int scale_n_stride_param,
    int scale_k_stride_param,
    int64_t expert_stride_z_param,
    int zero_n_stride_param,
    int zero_k_stride_param,
    int scale_mode,
    int group_size,
    int n_block_shift,
    bool scale_is_bf16,
    bool is_signed_int8,
    bool static_scheduler) {
  using ElementA = cutlass::bfloat16_t;
  using ElementBPacked = std::conditional_t<IsInt8, int8_t, cutlass::float_e4m3_t>;
  using ElementD = cutlass::bfloat16_t;
  auto make_dummy_tensor = [&](auto val, auto stride) {
    return make_tensor(make_gmem_ptr(&val), make_layout(repeat<rank_v<decltype(stride)>>(1), stride));
  };
  using TensorA = decltype(make_dummy_tensor(ElementA{}, Stride<int, _1>{}));
  using TensorBPacked = decltype(make_dummy_tensor(ElementBPacked{}, Stride<_1, int>{}));
  using TensorD = decltype(make_dummy_tensor(ElementD{}, Stride<int, _1>{}));
  using MMA = typename TiledMMAHelper<
      MMA_Atom<XE_DPAS_TT<8, float, cutlass::bfloat16_t>>, Layout<Tile>, SGLayout>::TiledMMA;
  auto mma = MMA{};
  int sm_count = cutlass::KernelHardwareInfo::query_device_multiprocessor_count(0);
  auto max_threads_per_workgroup = size(mma);
  static constexpr int MaxThreadsPerSM = 512;
  TORCH_CHECK(
      MaxThreadsPerSM % max_threads_per_workgroup == 0,
      "MaxThreadsPerSM must be divisible by MaxThreadsPerWorkgroup");
  sycl::range<3> local(1, 1, max_threads_per_workgroup);
  sycl::range<3> global(1, sm_count * MaxThreadsPerSM / max_threads_per_workgroup, 1);
  namespace syclex = sycl::ext::oneapi::experimental;
  namespace intelex = sycl::ext::intel::experimental;
  syclex::properties kernel_props{syclex::sub_group_size<16>, intelex::grf_size<256>};
  using Kernel = moe_w8a16::W8A16Kernel<
      Tile,
      SGLayout,
      TensorA,
      TensorBPacked,
      TensorD,
      MMA,
      IsInt8>;
  typename Kernel::Params params{
      static_cast<const uint8_t*>(activations),
      static_cast<const uint8_t*>(weights),
      weight_scales,
      static_cast<const uint8_t*>(weight_zeros),
      static_cast<const float*>(bias),
      static_cast<ElementD*>(outputs),
      num_rows_per_expert_device,
      gemm_n,
      gemm_k,
      num_experts,
      workspace,
      mma,
      static_cast<int32_t>(ld_b_param),
      expert_stride_b_param,
      expert_stride_s_param,
      static_cast<int32_t>(scale_n_stride_param),
      static_cast<int32_t>(scale_k_stride_param),
      expert_stride_z_param,
      static_cast<int32_t>(zero_n_stride_param),
      static_cast<int32_t>(zero_k_stride_param),
      scale_mode,
      group_size,
      n_block_shift,
      scale_is_bf16,
      is_signed_int8,
      static_scheduler};
  q.submit([&](sycl::handler& h) {
    sycl::local_accessor<int32_t, 1> local_mem(sycl::range<1>(1), h);
    h.parallel_for<GemmXe20W8A16Name<
      Tile, SGLayout, TensorA, TensorBPacked, TensorD, ElementD, IsInt8>>(
        sycl::nd_range<3>(global * local, local), kernel_props, [=](sycl::nd_item<3> item) {
          int32_t* slm_mem =
              static_cast<int32_t*>(local_mem.template get_multi_ptr<sycl::access::decorated::no>().get());
          Kernel{}(params, item, slm_mem);
        });
  });
}

template __attribute__((visibility("default"))) void Xe20MoEGEMMW8A16Launcher<
  @TILE@, @SGLAYOUT@, @IS_INT8@>(
    sycl::queue, const void*, const void*, const void*, const void*, const void*, void*,
    const int, const int, const int*, const int, int*, int, int64_t,
    int64_t, int, int, int64_t, int, int,
    int, int, int, bool, bool, bool);

#ifdef SGL_W8A16_JIT_ENTRY
extern "C" __attribute__((visibility("default"))) void sgl_moe_w8a16_entry(
    void* queue_ptr,
    const void* activations,
    const void* weights,
    const void* weight_scales,
    const void* weight_zeros,
    const void* bias,
    void* outputs,
    int gemm_n,
    int gemm_k,
    const int* rows_per_expert,
    int num_experts,
    int* workspace,
    int ld_b,
    int64_t expert_stride_b,
    int64_t expert_stride_s,
    int scale_n_stride,
    int scale_k_stride,
    int64_t expert_stride_z,
    int zero_n_stride,
    int zero_k_stride,
    int scale_mode,
    int group_size,
    int n_block_shift,
    bool scale_is_bf16,
    bool is_signed_int8,
    bool static_scheduler) {
  Xe20MoEGEMMW8A16Launcher<@TILE@, @SGLAYOUT@, @IS_INT8@>(
      *static_cast<sycl::queue*>(queue_ptr),
      activations,
      weights,
      weight_scales,
      weight_zeros,
      bias,
      outputs,
      gemm_n,
      gemm_k,
      rows_per_expert,
      num_experts,
      workspace,
      ld_b,
      expert_stride_b,
      expert_stride_s,
      scale_n_stride,
      scale_k_stride,
      expert_stride_z,
      zero_n_stride,
      zero_k_stride,
      scale_mode,
      group_size,
      n_block_shift,
      scale_is_bf16,
      is_signed_int8,
      static_scheduler);
}
#endif

#undef SYCL_INTEL_TARGET
