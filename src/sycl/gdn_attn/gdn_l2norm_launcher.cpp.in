// Standalone runtime-JIT module for the global l2norm(q, k) kernel.
#define SYCL_INTEL_TARGET 20

#include "sycl/gdn_attn/l2norm_kernel.hpp"

#ifdef SGL_GDN_L2NORM_JIT_ENTRY
extern "C" __attribute__((visibility("default"))) void sgl_gdn_l2norm_entry(
    sycl::queue& queue, const torch::Tensor& q, const torch::Tensor& k) {
  l2norm(queue, q, k);
}
#endif

#undef SYCL_INTEL_TARGET
