namespace prefill {

template <>
__attribute__((visibility("default"))) void FmhaPrefillFp8Runner<@HEAD_DIM@, @ELEM_TYPE@>::operator()(const Arguments& params) const {
  constexpr auto kTile = sgl::fmha::prefill_paged_tile(@HEAD_DIM@);
  using TileShapeQK = cute::Shape<cute::Int<kTile.tiled_q>, cute::Int<kTile.tiled_kv>, cute::_32>;
  using TileShapePV = cute::Shape<cute::Int<kTile.tiled_q>, cute::_32, cute::Int<kTile.tiled_kv>>;
  using TileShapeOutput = cute::Shape<cute::Int<kTile.tiled_q>, cute::Int<sgl::fmha::prefill_tiled_out(@HEAD_DIM@)>>;
