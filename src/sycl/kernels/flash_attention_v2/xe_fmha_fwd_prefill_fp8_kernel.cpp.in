    AT_DISPATCH_BOOL_NO_RETURN(params.is_causal, Causal, {
      using QElement = @ELEM_TYPE@;
      if (params.is_e4m3) {
        FMHAConfig<
             Causal, LocalMask, false, false, TileShapeQK, TileShapePV, TileShapeOutput, SubgroupLayoutQK, void, false, 2, false,
             QElement, cutlass::float_e4m3_t, cutlass::float_e4m3_t, QElement>::run_paged(params);
       } else {
         FMHAConfig<
             Causal, LocalMask, false, false, TileShapeQK, TileShapePV, TileShapeOutput, SubgroupLayoutQK, void, false, 2, false,
             QElement, cutlass::float_e5m2_t, cutlass::float_e5m2_t, QElement>::run_paged(params);
