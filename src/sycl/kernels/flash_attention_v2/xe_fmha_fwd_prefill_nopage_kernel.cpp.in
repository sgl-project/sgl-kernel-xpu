template <typename TileShapeQK, typename TileShapePV, typename TileShapeOutput, typename SubgroupLayoutQK>
void run_nopaged_tile(const Arguments& params) {
  AT_DISPATCH_BOOL_NO_RETURN(params.is_local, LocalMask, {
    AT_DISPATCH_BOOL_NO_RETURN(params.is_causal, Causal, {
      using Element = bfloat16_t;
      FMHAConfig<
          Causal,
          LocalMask,
          false,
          TileShapeQK,
          TileShapePV,
          TileShapeOutput,
          SubgroupLayoutQK,
          void,
          2,
          false,
          Element,
          Element,
          Element,
          Element>::run_nopaged(params);
    });
  });
}

